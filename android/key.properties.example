# Copy this file to `android/key.properties` before uploading to Google Play Console.
# Generate upload keystore:
#   keytool -genkey -v -keystore ~/keystone-upload-keystore.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upload
storePassword=CHANGE_ME
keyPassword=CHANGE_ME
keyAlias=upload
storeFile=/absolute/path/to/keystone-upload-keystore.jks

